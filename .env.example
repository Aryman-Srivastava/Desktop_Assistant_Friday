# Deployment environment settings (never commit .env)
FRIDAY_ENV=development
FRIDAY_LOG_LEVEL=INFO
FRIDAY_MAX_COMMAND_LENGTH=240
FRIDAY_MAX_MESSAGE_LENGTH=2000

# Gmail App Password credentials (never commit .env)
FRIDAY_GMAIL_ADDRESS=your-address@gmail.com
FRIDAY_GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional executable paths. Leave blank to use the system default browser.
FRIDAY_BROWSER_EXECUTABLE=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
FRIDAY_PYCHARM_EXECUTABLE=C:\\Program Files\\JetBrains\\PyCharm\\bin\\pycharm64.exe
FRIDAY_CONTACTS_FILE=contacts.json
